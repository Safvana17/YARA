
<%- include("../../views/partials/user/navbar") %>
<style>
      .coupon-card {
    border-left: 5px solid #28a745;
    transition: transform 0.2s ease-in-out;
  }

  .coupon-card:hover {
    transform: scale(1.01);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
  }

  .coupon-card .btn {
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  .coupon-card strong {
    font-size: 1.2rem;
    font-family: 'Courier New', Courier, monospace;
    color: #155724;
  }
        .shop-banner {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    margin-top: 0 !important;
  padding-top: 0 !important;
  }
  .shop-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .banner-text {
    position: absolute;
    top: 50%;
    left: 5%;
    transform: translateY(-50%);
    color: black;
  }
  .banner-text h1 {
   font-family: 'Cinzel', serif;
  font-size: 4rem;
  color: black;
  letter-spacing: 2px;
  text-shadow: 2px 2px 5px rgba(0,0,0,0.5);
  margin-bottom: 10px;
}

.banner-text p {
  font-family: 'Poppins', sans-serif;
  font-size: 1.2rem;
  color: black;
  text-shadow: 1px 1px 3px rgba(0,0,0,0.4);
}
</style>
 <div class="shop-banner mb-4">
  <img src="/images/cpnbg1.jpg" alt="Banner">
  <div class="banner-text">
    <h1>YARA</h1>
    <p>Style is the real statement</p>
  </div>
</div>
<div class="container my-5 flex-grow-1">
  <div class="row">
        <!-- sidebar -->
    <div class="col-md-3">
      <%- include("../../views/partials/user/sidebar") %>
    </div>
  <div class="col-md-9">
    <h3 class="mb-3 text-success text-center"> Available Coupons</h3>
    <% if(usableCoupons.length === 0) { %>
        <div class="text-center mt-5">
        <img src="/images/noCoupons.jpg" alt="empty-wish-list" style="width: 150px; height: 100%;" ><br>
        <h5><strong>No Coupons Available For You!</strong><br></h5>
        <p class="text-muted">Looks like you haven't received any coupons yet.<br>Shop more to unlock exciting rewards and discounts.</p>
        <a href="/shop" class="btn btn-outline-success mt-3">Start Shopping</a>
        </div>
    <% } else { %>
        <h3 class="mb-4 text-center">🎉 You've Got <%= usableCoupons.length %> Coupon<%= usableCoupons.length > 1 ? 's' : '' %>!</h3>
        <p class="text-center text-muted mb-5">Apply the coupon code at checkout to get instant discounts. Happy shopping!</p>
        <% usableCoupons.forEach(coupons => { %>
            <div class="card coupon-card shadow-sm border-success mb-4">
              <div class="card-body text-center">
                <h5 class="card-title text-success mb-3">
                <i class="bi bi-ticket-detailed-fill me-2"></i>Special Offer Just for You!
                </h5>
                <p class="text-muted mb-4">Use the coupon code below during checkout to save on your next purchase.</p><br>
                <strong>Valid on orders above <%= coupons.minOrderAmount %></strong>

                <div class="d-inline-flex align-items-center border border-success rounded px-4 py-2 bg-light">
                <strong id="couponCode"><%= coupons.code %></strong>
                <button class="btn btn-sm btn-outline-success ms-3" onclick="copyReferralCode()">Copy</button>
                </div>
              </div>
            </div>
        <% }) %>
                <% if(totalPages > 1) { %>
        <nav class="mb-5">
            <ul class="pagination justify-content-center">
               <% for(let i=1; i<=totalPages; i++){ %>
                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                    <a  class="page-link" href="/coupons?page=<%= i %>&search=<%= search %>"><%= i %></a>
                </li>
               <% } %>
            </ul>
        </nav>
    <% } %>
    <% } %>
</div>
</div>
</div>
<%- include("../../views/partials/user/footer") %>
 <!-- Bootstrap Bundle JS (includes Popper) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function copyReferralCode() {
  const code = document.getElementById("couponCode").textContent;
  navigator.clipboard.writeText(code).then(() => {
    Swal.fire({
      icon: 'success',
      title: 'Copied!',
      text: 'Coupon code copied to clipboard!',
      timer: 2000,
      showConfirmButton: false
    });
  }).catch(() => {
    Swal.fire('Oops!', 'Failed to copy the code.', 'error');
  });
}

</script>

