<%- include("../../views/partials/user/navbar") %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
<style>
        .shop-banner {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    margin-top: 0 !important;
  padding-top: 0 !important;
  }
  .shop-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .banner-text {
    position: absolute;
    top: 50%;
    left: 5%;
    transform: translateY(-50%);
    color: black;
  }
  .banner-text h1 {
   font-family: 'Cinzel', serif;
  font-size: 4rem;
  color: black;
  letter-spacing: 2px;
  text-shadow: 2px 2px 5px rgba(0,0,0,0.5);
  margin-bottom: 10px;
}

.banner-text p {
  font-family: 'Poppins', sans-serif;
  font-size: 1.2rem;
  color: black;
  text-shadow: 1px 1px 3px rgba(0,0,0,0.4);
}
</style>
 <div class="shop-banner mb-4">
  <img src="/images/cpnbg1.jpg" alt="Banner">
  <div class="banner-text">
    <h1>YARA</h1>
    <p>Style is the real statement</p>
  </div>
</div>
<div class="container my-5">
  <div class="row">
    <!-- sidebar -->
    <div class="col-md-3">
      <%- include("../../views/partials/user/sidebar") %>
    </div>
  <div class="col-md-9">
  <h3 class="text-center mb-4">My Wallet</h3>

  <div class="card shadow-sm p-4 mb-4">
    <h5>Wallet Balance:</h5>
    <h2 class="<%= user.wallet > 0 ? 'text-success' : 'text-danger' %>">₹<%= user.wallet.toFixed(2) %></h2>
    
    <% if (user.wallet === 0) { %>
      <p class="text-muted mt-2">No money in wallet. Add some to start shopping.</p>
    <% } %>

    <div class="text-end">
      <a href="/add-money" class="btn btn-primary">Add Money</a>
    </div>
  </div>

  <div class="card shadow-sm p-4">
    <h5 class="mb-3">Transaction History</h5>

    <% if (walletTransactions.length === 0) { %>
      <p class="text-muted">No transactions found.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-bordered align-middle">
          <thead class="table-light">
            <tr>
              <th>Date</th>
              <th>Status</th>
              <th>Method</th>
              <th>Description</th>
              <th class="text-end">Amount (₹)</th>
            </tr>
          </thead>
          <tbody>
            <% walletTransactions.forEach(tx => { %>
              <tr>
                <td><%= new Date(tx.date).toLocaleDateString() %></td>
                <td>
                  <% if(tx.status === 'used for order') { %>
                    <span class="badge bg-danger"><%= tx.status %></span>
                  <% } else if(tx.status === 'refund') { %>
                    <span class="badge bg-success"><%= tx.status %></span>
                  <% } else if(tx.status === 'reward') { %>
                    <span class="badge bg-warning text-dark"><%= tx.status %></span>
                  <% } else { %>
                    <span class="badge bg-primary"><%= tx.status %></span>
                  <% } %>
                </td>
                <td><%= tx.method %></td>
                <td>
                    <%= tx.description %>
                </td>
                <td class="text-end">₹<%= tx.amount.toFixed(2) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
  </div>
  </div>
</div>

      <% if(totalPages > 1) { %>
        <nav class="mb-5">
            <ul class="pagination justify-content-center">
               <% for(let i=1; i<=totalPages; i++){ %>
                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                    <a  class="page-link" href="/wallet?page=<%= i %>&search=<%= search %>"><%= i %></a>
                </li>
               <% } %>
            </ul>
        </nav>
    <% } %>
<%- include("../../views/partials/user/footer") %>
  <!-- Bootstrap Bundle JS (includes Popper) -->
   <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
