<%- include("../../views/partials/user/navbar") %>
<style>
        .shop-banner {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    margin-top: 0 !important;
  padding-top: 0 !important;
  }
  .shop-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .banner-text {
    position: absolute;
    top: 50%;
    left: 5%;
    transform: translateY(-50%);
    color: black;
  }
  .banner-text h1 {
   font-family: 'Cinzel', serif;
  font-size: 4rem;
  color: black;
  letter-spacing: 2px;
  text-shadow: 2px 2px 5px rgba(0,0,0,0.5);
  margin-bottom: 10px;
}

.banner-text p {
  font-family: 'Poppins', sans-serif;
  font-size: 1.2rem;
  color: black;
  text-shadow: 1px 1px 3px rgba(0,0,0,0.4);
}
</style>
 <div class="shop-banner mb-4">
  <img src="/images/cpnbg1.jpg" alt="Banner">
  <div class="banner-text">
    <h1>YARA</h1>
    <p>Style is the real statement</p>
  </div>
</div>
<div class="container my-5 mt-5 mb-5">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-md-3">
      <div class="list-group shadow-sm">
        <%- include("../../views/partials/user/sidebar") %>
      </div>
    </div>

    <!-- Address Section -->
    <div class="col-md-9">
      <h4 class="mb-4 text-center">My Addresses</h4>

      <% if (!addressData || addressData.address.length === 0) { %>
        <div class="alert alert-warning text-center">
          No user address available.
        </div>
      <% } else { %>
        <div class="row">
          <% addressData.address.forEach((addr, index) => { %>
            <div class="col-md-6 mb-4">
              <div class="card p-3 shadow-sm">
                <h6><%= addr.addressType %> Address
                  <% if (addr.isDefault) { %>
                  <span class="badge bg-success py-1 px-2 small">Default Address</span>
                <% } %>
                </h6>
                <p><strong>Name:</strong> <%= addr.name %></p>
                <p><strong>House No:</strong> <%= addr.houseNo %></p>
                <p><strong>City:</strong> <%= addr.city %>, <%= addr.state %> - <%= addr.pinCode %></p>
                <p><strong>Landmark:</strong> <%= addr.landMark %></p>
                <p><strong>Phone:</strong> <%= addr.phone %> | <strong>Alt:</strong> <%= addr.altPhone %></p>

                <div class="d-flex gap-2">
                  <a href="/edit-address/<%= addr._id %>" class="btn btn-sm btn-outline-primary">Edit</a>
                  <button onclick="deleteAddress('<%= addr._id %>')" class="btn btn-sm btn-outline-danger">Delete</button>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <div class="text-end">
        <a href="/add-address" class="btn btn-success mt-3">+ Add New Address</a>
      </div>
    </div>
  </div>
</div>
                  <% if(totalPages > 1) { %>
        <nav class="mb-5">
            <ul class="pagination justify-content-center">
               <% for(let i=1; i<=totalPages; i++){ %>
                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                    <a  class="page-link" href="/address?page=<%= i %>&search=<%= search %>"><%= i %></a>
                </li>
               <% } %>
            </ul>
        </nav>
    <% } %>

<%- include("../../views/partials/user/footer") %>
  <!-- Bootstrap Bundle JS (includes Popper) -->
   <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  async function deleteAddress(addressId) {
    const confirmDelete = confirm("Are you sure you want to delete this address?");
    if (!confirmDelete) return;

    try {
      const response = await fetch(`/delete-address/${addressId}`, {
        method: 'DELETE'
      });

      const result = await response.json();

      if (response.ok && result.success) {
        Swal.fire({
          icon: 'success',
          title: 'Address Deleted!',
          text: 'User address deleted successfully'
        })
        .then(() => {
          location.reload(); 
        })
      } else {
        Swal.fire({
          icon: 'warning',
          title: 'Oops!',
          text: result.message || 'Something went wrong'
        })
      }
    } catch (err) {
      console.error('Delete error:', err);
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: err.message || 'Internal server error'
      })
    }
  }
</script>
