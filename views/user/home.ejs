   <style>
      .btn {
      display: inline-block;
      padding: 12px 20px;
      font-size: 16px;
      font-weight: bold;
      color: #fff;
      background-color: #ff6b6b;
      border: none;
      border-radius: 5px;
      transition: background-color 0.3s, transform 0.3s;
      cursor: pointer;
      text-align: center;
  }


  .btn:hover {
      background-color: #ff4c4c;
      transform: translateY(-2px);
  }


  .btn:active {
      transform: translateY(1px);
  }
  .wishlist-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      background-color: rgba(255, 255, 255, 0.8);
      padding: 10px;
      border-radius: 50%;
      color: #ff6b6b;
      font-size: 18px;
      z-index: 10;
      transition: background-color 0.3s, color 0.3s, transform 0.3s;
  }


  .wishlist-btn:hover {
      background-color: rgba(255, 255, 255, 1);
      color: #ff4c4c;
      transform: translateY(-2px);
  }


  .wishlist-btn:active {
      transform: translateY(1px);
  }
   .section-title h2 {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 30px;
    color: #252525;
  }
   
  .product-img-action-wrap {
      position: relative;
  }


  .product-img {
      position: relative;
      display: block;
      overflow: hidden;
      width: 100%;
      height: 250px;
      border-radius: 5px;
  }
  .product-img img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 5px;
    transition: transform 0.3s ease;
  }
  .product-img:hover img {
    transform: scale(1.05);
  }

  .product-cart-wrap {
    border: 1px solid #ddd;
    padding: 15px;
    border-radius: 8px;
    transition: box-shadow 0.3s ease;
    background-color: #fff;
    height: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    overflow: hidden;
    box-shadow: 0 0 10px rgba(0,0,0,0.06);
  }
  .product-cart-wrap:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

    .product-content-wrap {
    padding-top: 10px;
    text-align: center;
  }
   .product-content-wrap h6 {
    font-size: 1rem;
    font-weight: 600;
    color: #333;
    margin: 10px 0 5px;
    height: 40px;
    overflow: hidden;
  }


  .product-content-wrap h5 {
      font-size: 1.1rem;
      color: #ff6b6b;
      margin-bottom: 10px;
  }


  .product-content-wrap a {
      display: inline-block;
      padding: 8px 12px;
      background-color: #ff6b6b;
      color: white;
      text-transform: uppercase;
      font-size: 14px;
      border-radius: 4px;
      text-decoration: none;
  }


  .product-content-wrap a:hover {
      background-color: #ff4c4c;
  }
  .single-slider-img img {
    max-height: 520px; /* adjust this value as needed */
    object-fit: cover;
}
.brand-section {
  padding: 40px 0;
  background-color: #f5f4f4;
}

.brand-logo {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 30px;
}

.brand-logo img {
  max-width: 120px;
  max-height: 60px;
  object-fit: contain;
  transition: transform 0.3s ease;
  /* filter: grayscale(100%); */
  opacity: 0.8;
}

.brand-logo img:hover {
  transform: scale(1.1);
  filter: grayscale(0%);
  opacity: 1;
}

.promo-poster {
  position: relative;
  height: 300px;
  background-size: cover;
  background-position: center;
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s;
}

.promo-poster:hover {
  transform: scale(1.02);
}

.promo-overlay {
  background-color: rgba(0, 0, 0, 0.4);
  padding: 30px;
  width: 100%;
  height: 100%;
  backdrop-filter: blur(2px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.promo-overlay h3 {
  font-size: 1.8rem;
  font-weight: 600;
}

.swiper-slide {
  display: flex;
  justify-content: center;
  height: auto;
}
/* Positioning and appearance */
.swiper-button-next,
.swiper-button-prev {
  color: #fff;
  background-color: rgba(0, 0, 0, 0.5); /* semi-transparent black */
  width: 60px;
  height: 60px;
  border-radius: 50%;
  top: 40%;
  transition: all 0.3s ease;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
}

/* Icon centering */
.swiper-button-next::after,
.swiper-button-prev::after {
  font-size: 18px;
  font-weight: bold;
}

/* Hover effect */
.swiper-button-next:hover,
.swiper-button-prev:hover {
  background-color: #24ddda; /* your theme red-maroon or custom color */
  color: #fff;
}

.carousel,
  .carousel-inner,
  .carousel-item {
    height: 100vh;
    width: 100vw;
  }

  .carousel-item img {
    object-fit: cover;
  }

  .carousel-caption {
    background: rgba(0, 0, 0, 0.4); /* Optional: caption background */
    padding: 1rem;
    border-radius: 10px;
  }
  .carousel-caption.custom-caption {
  top: 50%;
  transform: translateY(-50%);
  bottom: auto;
  text-align: center;
}

.custom-heading {
  font-family: 'Playfair Display', serif; /* You can replace with another if you want */
  font-size: 5rem;
  letter-spacing: 2px;
  font-weight: bold;
  color: goldenrod;
}

.custom-subtext {
  font-size: 0.2rem;
  color: #f1f1f1;
}

.coupon-banner {
  position: relative;
  width: 100%;
  height: 300px;
  overflow: hidden;
}

.banner-slide {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  position: relative;
}

.banner-text {
  position: absolute;
  bottom: 30px;
  left: 40px;
  color: #fff;
  background: rgba(0,0,0,0.5);
  padding: 15px 20px;
  border-radius: 8px;
}

.banner-btn {
  display: inline-block;
  margin-top: 10px;
  background: yellowgreen;
  padding: 8px 16px;
  color: black;
  border-radius: 4px;
  text-decoration: none;
}


 @media (max-width: 768px) {
    .product-img img {
      height: 200px;
    }
  }
   </style>
   <header class="hero-section">
  <div id="carouselExampleCaptions" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
  <div class="carousel-indicators">
    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
  </div>

  <div class="carousel-inner">
    <!-- Slide 1 with collage -->
    <div class="carousel-item active">
      <div class="d-flex w-100 h-100">
        <!-- Left tall image -->
        <div class="w-50 h-100">
          <img src="/images/kurta.jpg" class="w-100 h-100" alt="Left Image">
        </div>
        <!-- Right two stacked images -->
        <div class="w-50 d-flex flex-column">
          <div class="h-50">
            <img src="/images/home1.jpg" class="w-100 h-100" alt="Top Right Image">
          </div>
          <div class="h-50">
            <img src="/images/home5.jpg" class="w-100 h-100" alt="Bottom Right Image">
          </div>
        </div>
      </div>

      <!-- Slide 1 caption -->
      <div class="carousel-caption custom-caption">
        <h1 class="custom-heading">YARA</h1>
        <p class="custom-subtext">Grace in every thread, elegance in every step.</p>
      </div>
    </div>

    <!-- Slide 2 -->
    <div class="carousel-item">
      <img src="/images/couponbg.jpg" class="d-block w-100 h-100" alt="Slide 2">
      <div class="carousel-caption custom-caption">
        <h1 class="custom-heading">YARA</h1>
        <p class="custom-subtext">Unfold your elegance with every wear.</p>
      </div>
    </div>

    <!-- Slide 3 -->
    <div class="carousel-item">
      <img src="/images/home3.jpg" class="d-block w-100 h-100" alt="Slide 3">
      <div class="carousel-caption custom-caption">
        <h1 class="custom-heading">YARA</h1>
        <p class="custom-subtext">Wrapped in softness, designed for you.</p>
      </div>
    </div>
  </div>

  <!-- Controls -->
  <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>
</header>
<!-- banner section -->
 
<% if (activeBanner && activeBanner.length > 0) { %>
  <% if (activeBanner.length > 1) { %>
    <!-- Swiper Slider -->
    <section class="coupon-banner mt-3 swiper mySwiper" data-aos="zoom-in">
      <div class="swiper-wrapper">
        <% activeBanner.forEach(banner => { %>
          <div class="swiper-slide banner-slide" style="background-image: url('<%= banner.image %>');">
            <div class="banner-text">
              <h2><%= banner.title %></h2>
              <p><%= banner.description %></p>
              <% if (banner.link) { %>
                <a href="<%= banner.link %>" class="banner-btn">Shop Now</a>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-pagination"></div>
    </section>
  <% } else { %>
    <!-- Single Banner (No Swiper) -->
    <section class="coupon-banner mt-3" data-aos="zoom-in">
      <div class="banner-slide" style="background-image: url('<%= activeBanner[0].image %>');">
        <div class="banner-text">
          <h2><%= activeBanner[0].title %></h2>
          <p><%= activeBanner[0].description %></p>
          <% if (activeBanner[0].link) { %>
            <a href="<%= activeBanner[0].link %>" class="banner-btn">Shop Now</a>
          <% } %>
        </div>
      </div>
    </section>
  <% } %>
<% } %>




